<%- include("partials/header", { title }) %>
<main>
  <h1>Edit Category</h1>
  <% if (errors.length) { %><div class="form-errors" role="alert"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
  <form action="/categories/edit-category/<%= category.category_id %>" method="post" class="data-form">
    <label for="category_name">Category Name</label>
    <input id="category_name" name="category_name" type="text" value="<%= category.name %>" required maxlength="100">
    <button type="submit">Update Category</button>
  </form>
  <p><a href="/categories">← Back to Categories</a></p>
</main>
<%- include("partials/footer") %>
