<%- include("partials/header") %>

<main>
  <h1>Create New Organization</h1>

  <% if (errors && errors.length > 0) { %>
    <div class="errors">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/organizations/new" method="POST">

    <div>
      <label for="name">Organization Name:</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= organization.name || '' %>"
        required
      >
    </div>

    <div>
      <label for="description">Description:</label>
      <textarea
        id="description"
        name="description"
        required
      ><%= organization.description || '' %></textarea>
    </div>

    <div>
      <label for="contact_email">Contact Email:</label>
      <input
        type="email"
        id="contact_email"
        name="contact_email"
        value="<%= organization.contact_email || '' %>"
        required
      >
    </div>

    <div>
      <label for="logo_filename">Logo Filename:</label>
      <input
        type="text"
        id="logo_filename"
        name="logo_filename"
        value="<%= organization.logo_filename || '' %>"
      >
    </div>

    <button type="submit">Create Organization</button>

  </form>

  <p>
    <a href="/organizations">← Back to Organizations</a>
  </p>
</main>

<%- include("partials/footer") %>