<%- include("partials/header", { title: title }) %>

<main>
  <h1>Service Projects</h1>

  <% if (user && user.role === "admin") { %>
    <p>
      <a href="/projects/new">Create New Project</a>
    </p>
  <% } %>

  <% if (projects.length === 0) { %>
    <p>No service projects found.</p>
  <% } else { %>
    <ul>
      <% projects.forEach((project) => { %>
        <li>
          <a href="/project/<%= project.project_id %>">
            <%= project.title %>
          </a>
          -
          <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
          </a>

          <p><%= project.description %></p>

          <p>
            <strong>Location:</strong> <%= project.location %>
            <strong>Date:</strong> <%= project.date %>
          </p>

          <% if (user && user.role === "admin") { %>
            <p>
              <a href="/projects/<%= project.project_id %>/edit">
                Edit Project
              </a>

              |
              
              <a href="/projects/<%= project.project_id %>/categories">
                Assign Categories
              </a>
            </p>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<%- include("partials/footer") %>